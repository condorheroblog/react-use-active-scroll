{
	"name": "react-use-active-scroll",
	"type": "module",
	"version": "0.0.1",
	"private": false,
	"description": "Accurate TOC/sidebar links without compromises for React.",
	"author": {
		"name": "Condor Hero",
		"email": "love2xinwei@gmail.com"
	},
	"license": "MIT",
	"homepage": "https://condorheroblog.github.io/react-use-active-scroll/",
	"repository": {
		"type": "git",
		"url": "https://github.com/condorheroblog/react-use-active-scroll.git"
	},
	"bugs": {
		"url": "https://github.com/condorheroblog/react-use-active-scroll/issues"
	},
	"keywords": [
		"react",
		"react18",
		"react-scroll",
		"react-scroll-active",
		"react-active-scroll",
		"react-active-link",
		"react-toc",
		"scrollspy",
		"scroll-spy",
		"framework-agnostic",
		"vanilla-js",
		"vue",
		"solid"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"files": [
		"dist/*"
	],
	"scripts": {
		"prepare": "simple-git-hooks",
		"prepublishOnly": "npm run build",
		"build": "rm -rf dist && tsc --noEmit && vite build",
		"test": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp -r && pnpm -r publish --access public"
	},
	"dependencies": {
		"scroll-active-toc": "^0.0.2"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@eslint-react/eslint-plugin": "^5.18.7",
		"@microsoft/api-extractor": "^7.59.0",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"bumpp": "^12.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"lint-staged": "^17.5.0",
		"react": "^19.2.8",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^6.0.3",
		"unplugin-dts": "^1.1.0",
		"vite": "8.2.2",
		"vitest": "^4.1.11"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs,cts,mts,json,md}": [
			"eslint --fix"
		]
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
